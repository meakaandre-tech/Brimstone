{
  "suite": "core",
  "requiresMod": null,
  "description": "A plain world: only Fabric API and Brimstone. Coordinates assume nothing about the world but its seed (CI uses 12345).",
  "preamble": [
    "gamerule advance_time false",
    "gamerule advance_weather false",
    "gamerule send_command_feedback false",
    "gamemode spectator @a",
    "time set 6000",
    "weather clear"
  ],
  "scenes": [
    {
      "id": "spawn",
      "title": "World spawn of seed 12345, 8 chunks, daylight (fixed camera height above the terrain)",
      "renderDistance": 8,
      "settleSeconds": 20,
      "setup": [
        "execute in minecraft:overworld run tp @a 96.5 165 -27.5 0 30"
      ]
    },
    {
      "id": "flythrough",
      "title": "Fly-through over fresh terrain, 12 chunks, scripted path north at 10 blocks/s",
      "renderDistance": 12,
      "settleSeconds": 20,
      "setup": [
        "execute in minecraft:overworld run tp @a -6000.5 170 -6000.5 180 15"
      ],
      "velocity": [
        0.0,
        0.0,
        -10.0
      ],
      "ciGatedCounts": [
        "heapUsedAfterGcMB",
        "directBuffersMB"
      ],
      "ciNote": "CI gates only memory here: upload volume and draw calls depend on how fast CI's server generates the new terrain."
    },
    {
      "id": "water_glass",
      "title": "Water, ice and stained glass in a glass tank",
      "renderDistance": 8,
      "settleSeconds": 20,
      "setup": [
        "execute in minecraft:overworld run tp @a 2000.5 209 -1984.5 180 35",
        "#wait 6",
        "fill 1990 199 -2010 2010 199 -1990 minecraft:smooth_stone",
        "fill 1990 200 -2010 2010 208 -1990 minecraft:air",
        "fill 1992 200 -2008 2008 205 -1992 minecraft:glass hollow",
        "fill 1993 201 -2007 2007 204 -1993 minecraft:water",
        "fill 1995 201 -2005 1997 203 -2003 minecraft:ice",
        "fill 2002 201 -2005 2004 204 -2003 minecraft:light_blue_stained_glass",
        "fill 1994 206 -1996 2006 206 -1996 minecraft:red_stained_glass_pane",
        "fill 1990 200 -1990 2010 203 -1990 minecraft:white_stained_glass_pane",
        "execute in minecraft:overworld run tp @a 2000.5 209 -1984.5 180 35"
      ]
    },
    {
      "id": "nether",
      "title": "The nether",
      "renderDistance": 8,
      "settleSeconds": 20,
      "setup": [
        "execute in minecraft:the_nether run tp @a 0.5 40 0.5 45 10"
      ]
    },
