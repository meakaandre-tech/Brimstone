    {
      "id": "spawn",
      "title": "World spawn of seed 12345, 8 chunks, daylight (fixed camera height above the terrain)",
      "renderDistance": 8,
      "settleSeconds": 20,
      "setup": [
        "execute in minecraft:overworld run tp @a 96.5 165 -27.5 0 30"
      ]
    },
    {
      "id": "flythrough",
      "title": "Fly-through over fresh terrain, 12 chunks, scripted path north at 10 blocks/s",
      "renderDistance": 12,
      "settleSeconds": 20,
      "setup": [
        "execute in minecraft:overworld run tp @a -6000.5 170 -6000.5 180 15"
      ],
      "velocity": [
        0.0,
        0.0,
        -10.0
      ],
      "ciGatedCounts": [
