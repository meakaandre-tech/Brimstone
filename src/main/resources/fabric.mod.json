{
  "schemaVersion": 1,
  "id": "brimstone",
  "version": "${version}",
  "name": "Brimstone",
  "description": "An all-in-one optimisation mod, starting with a renderer rewrite. Draws exactly what vanilla draws.",
  "authors": [
    "Andre"
  ],
  "contact": {
    "sources": "https://github.com/meakaandre-tech/Brimstone"
  },
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.meakaandre.brimstone.Brimstone"
    ],
    "client": [
      "com.meakaandre.brimstone.BrimstoneClient"
    ]
  },
  "mixins": [
    "brimstone.mixins.json",
    "brimstone.counters.mixins.json",
    "brimstone.terrain.mixins.json",
    "brimstone.visibility.mixins.json",
    "brimstone.frapi.mixins.json"
  ],
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3- <26.4-",
    "java": ">=25",
    "fabric-api": "*"
  }
}
