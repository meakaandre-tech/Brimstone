{
  "schemaVersion": 1,
  "id": "brimstone_bench",
  "version": "${version}",
  "name": "Brimstone bench",
  "description": "Only Brimstone's benchmark: /brimstone bench, its counters and scenes. Changes nothing in the game; measures vanilla, Sodium or anything else the same way.",
  "authors": [
    "Andre"
  ],
  "contact": {
    "sources": "https://github.com/meakaandre-tech/Brimstone"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.meakaandre.brimstone.bench.BenchOnlyClient"
    ]
  },
  "mixins": [
    "brimstone_bench.counters.mixins.json"
  ],
  "breaks": {
    "brimstone": "*"
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3- <26.4-",
    "java": ">=25",
    "fabric-api": "*"
  }
}
